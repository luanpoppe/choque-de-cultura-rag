# Copie para .env na raiz do monorepo e ajuste se necessário.
# Credenciais devem coincidir com docker-compose.yml (user/senha/db: choque / choque / choque_rag).
# Porta 6017 no host → 5432 no container.
DATABASE_URL=postgresql://choque:choque@localhost:6017/choque_rag

# Backend — IA via OpenRouter (chat, embeddings e Whisper/STT)
PORT=3000
OPENROUTER_API_KEY=
# GEMINI_API_KEY=
# EMBEDDING_MODEL=openai/text-embedding-3-small
# STT: whisper-1 roteia via OpenAI (compatível com providers permitidos no OpenRouter).
# whisper-large-v3 exige Groq/Together na conta OpenRouter.
# WHISPER_MODEL=openai/whisper-1
# YTDLP_BIN=yt-dlp
# INGEST_TEMP_DIR=
INGEST_SECRET=change-me-in-production
# CHOQUE_YOUTUBE_CHANNEL_URL=https://www.youtube.com/@CanalChoqueDeCultura
# INGEST_DEFAULT_LIMIT=10
# SWAGGER_EXPOSE_INTERNAL=false
# CHAT_MODEL=openrouter/openai/gpt-4o-mini
# RAG_TOP_K=6
# RAG_MAX_DISTANCE=0.85
# RAG_MAX_QUOTE_CHARS=280
# RAG_MAX_HISTORY_MESSAGES=20
# CHAT_RATE_LIMIT_MAX=20
# CHAT_RATE_LIMIT_WINDOW_MS=60000

# Frontend (Next.js — prefixo NEXT_PUBLIC_)
# NEXT_PUBLIC_API_URL=http://localhost:3011
# NEXT_PUBLIC_GITHUB_URL=https://github.com/seu-usuario/choque-de-cultura-rag
