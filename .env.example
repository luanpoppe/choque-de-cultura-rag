# Copie para .env na raiz do monorepo e ajuste se necessário.
# Credenciais devem coincidir com docker-compose.yml (user/senha/db: choque / choque / choque_rag).
# Porta 6017 no host → 5432 no container.
DATABASE_URL=postgresql://choque:choque@localhost:6017/choque_rag

# Backend — IA via OpenRouter (chat, embeddings e Whisper/STT)
PORT=3000
OPENROUTER_API_KEY=
# GEMINI_API_KEY=
# EMBEDDING_MODEL=openai/text-embedding-3-small
# WHISPER_MODEL=openai/whisper-large-v3
# INGEST_SECRET=
