# Copie para .env na raiz do monorepo e ajuste se necessário.
# Credenciais devem coincidir com docker-compose.yml (user/senha/db: choque / choque / choque_rag).
# Porta 6017 no host → 5432 no container.
DATABASE_URL=postgresql://choque:choque@localhost:6017/choque_rag

# Backend — IA via OpenRouter (chat, embeddings)
PORT=3011
# error | warn | log | debug | verbose — use debug em dev para detalhes do RAG
# LOG_LEVEL=log
OPENROUTER_API_KEY=
# Ingestão: STT com timestamps reais (segmentos) via API OpenAI direta — mesma tarifa/min que whisper-1.
# OpenRouter /audio/transcriptions não retorna segmentos; ver story 1.6.
OPENAI_API_KEY=
# OPENAI_WHISPER_MODEL=whisper-1
# GEMINI_API_KEY=
# EMBEDDING_MODEL=openai/text-embedding-3-small
# STT: whisper-1 roteia via OpenAI (compatível com providers permitidos no OpenRouter).
# whisper-large-v3 exige Groq/Together na conta OpenRouter.
# WHISPER_MODEL=openai/whisper-1
# YTDLP_BIN=yt-dlp
# INGEST_TEMP_DIR=
INGEST_SECRET=change-me-in-production
# Ingestão automática: URL do canal (/videos) ou playlist de episódios (recomendado)
# CHOQUE_YOUTUBE_CHANNEL_URL=https://www.youtube.com/playlist?list=PLA2Gd9vTv5MWbT1N-RVoTO7MHkfjKkYVV
# INGEST_DEFAULT_LIMIT=10
# Primeiros N segundos: 1 segmento Whisper = 1 chunk ancorado no timestamp (memes no início). 0 = só janelas.
# INGEST_FINE_GRAINED_HEAD_SEC=180
# ±N segundos de fala vizinha incluídos no texto de cada chunk da zona fina (RAG + cards).
# INGEST_HEAD_CONTEXT_SEC=20
# Janelas após a zona fina (default 30s).
# INGEST_CHUNK_DURATION_SEC=30
# Overlap entre janelas após a zona fina (default 0.25 = 25%).
# INGEST_OVERLAP_RATIO=0.25
# SWAGGER_EXPOSE_INTERNAL=false
CHAT_MODEL=openrouter/deepseek/deepseek-v4-flash
# RAG_TOP_K=6
# RAG_MAX_DISTANCE=0.85
# RAG_MAX_HISTORY_MESSAGES=20
# RAG_AGENT_MAX_SEARCHES=4
# RAG_NEIGHBOR_CHUNKS=2
# CHAT_RATE_LIMIT_MAX=20
# CHAT_RATE_LIMIT_WINDOW_MS=60000

# Frontend (Next.js — prefixo NEXT_PUBLIC_; deve bater com PORT do backend)
NEXT_PUBLIC_API_URL=http://localhost:3011
# NEXT_PUBLIC_GITHUB_URL=https://github.com/seu-usuario/choque-de-cultura-rag
